# openai, anthropic, or gateway (Vercel AI Gateway)
MODEL_PROVIDER=openai

# A model id for that provider, such as gpt-6-luna or claude-sonnet-5-5.
# For the gateway, use provider/model, such as anthropic/claude-sonnet-5.5.
MODEL_ID=gpt-6-luna

# Set the key for the provider you chose.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
